<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zenitha Luxury — Brand Identity System</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Cormorant:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Mono:wght@300;400&family=Jost:wght@200;300;400;500&display=swap" rel="stylesheet">
<style>

/* ── RESET & BASE ────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
/* Exact colours extracted from zenitha.luxury */
–black:       #0C0C0C;
–black-2:     #111111;
–black-3:     #161616;
–gold:        #C49A2A;
–gold-muted:  #A07B1E;
–gold-pale:   #D4AF6A;
–gold-btn:    #C9A84C;   /* the CTA button fill */
–cream:       #F0EBE1;
–cream-dim:   #9E9080;
–cream-faint: #5A5248;
–border:      rgba(255,255,255,0.07);
–border-gold: rgba(196,154,42,0.2);

/* Typography — matching the site exactly */
–serif:  ‘Cormorant Garamond’, ‘Cormorant’, Georgia, serif;
–mono:   ‘DM Mono’, ‘Courier New’, monospace;
–label:  ‘Jost’, sans-serif;
}

html { scroll-behavior: smooth; }
body {
background: var(–black);
color: var(–cream);
font-family: var(–serif);
-webkit-font-smoothing: antialiased;
overflow-x: hidden;
line-height: 1.6;
}

::selection { background: var(–gold); color: var(–black); }
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: var(–black); }
::-webkit-scrollbar-thumb { background: var(–gold-muted); }

/* ── NAV ─────────────────────────────────────────── */
nav {
position: fixed; top: 0; left: 0; right: 0; z-index: 100;
padding: 1.25rem 2.5rem;
display: flex; align-items: center; justify-content: space-between;
border-bottom: 1px solid transparent;
transition: all 0.4s ease;
}
nav.scrolled {
background: rgba(12,12,12,0.95);
backdrop-filter: blur(16px);
border-bottom-color: var(–border);
}
.nav-logo {
width: 44px; height: 44px;
background: #fff;
display: flex; align-items: center; justify-content: center;
padding: 5px;
}
.nav-logo img { width: 100%; height: 100%; object-fit: contain; }
.nav-title {
font-family: var(–label);
font-size: 0.62rem;
font-weight: 400;
letter-spacing: 0.22em;
text-transform: uppercase;
color: var(–cream-dim);
}

/* ── HERO ─────────────────────────────────────────── */
.hero {
min-height: 100vh;
display: flex; flex-direction: column;
justify-content: flex-end;
padding: 0 2.5rem 5rem;
position: relative;
overflow: hidden;
}
.hero-bg {
position: absolute; inset: 0;
background: linear-gradient(180deg, rgba(12,12,12,0.3) 0%, rgba(12,12,12,0.85) 60%, var(–black) 100%);
z-index: 1;
}
.hero-noise {
position: absolute; inset: 0;
background-image: url(“data:image/svg+xml,%3Csvg viewBox=‘0 0 256 256’ xmlns=‘http://www.w3.org/2000/svg’%3E%3Cfilter id=‘n’%3E%3CfeTurbulence type=‘fractalNoise’ baseFrequency=‘0.9’ numOctaves=‘4’ stitchTiles=‘stitch’/%3E%3C/filter%3E%3Crect width=‘100%25’ height=‘100%25’ filter=‘url(%23n)’ opacity=‘0.04’/%3E%3C/svg%3E”);
z-index: 2; pointer-events: none; opacity: 0.6;
}
.hero-content { position: relative; z-index: 3; }
.hero-eyebrow {
font-family: var(–label);
font-size: 0.62rem;
font-weight: 300;
letter-spacing: 0.25em;
text-transform: uppercase;
color: var(–cream-dim);
margin-bottom: 1.5rem;
display: flex; align-items: center; gap: 0.75rem;
}
.hero-eyebrow::before {
content: ‘’;
display: block; width: 2rem; height: 1px;
background: var(–gold);
}
.hero-h1 {
font-family: var(–serif);
font-size: clamp(3.5rem, 10vw, 7rem);
font-weight: 300;
line-height: 0.95;
letter-spacing: -0.02em;
margin-bottom: 2rem;
}
.hero-h1 em {
font-style: italic;
color: var(–gold);
font-weight: 300;
}
.hero-sub {
font-family: var(–serif);
font-size: clamp(1rem, 2.5vw, 1.25rem);
font-weight: 300;
color: rgba(240,235,225,0.65);
max-width: 560px;
line-height: 1.7;
margin-bottom: 3rem;
}
.hero-sub em { font-style: normal; color: var(–gold); }

/* ── SECTION STRUCTURE ───────────────────────────── */
section { padding: 6rem 2.5rem; }
.section-label {
font-family: var(–label);
font-size: 0.6rem;
font-weight: 400;
letter-spacing: 0.3em;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 2.5rem;
display: flex; align-items: center; gap: 0.6rem;
}
.section-label span { color: var(–cream-faint); }
.section-h2 {
font-family: var(–serif);
font-size: clamp(2rem, 5vw, 3.5rem);
font-weight: 300;
line-height: 1.1;
margin-bottom: 1.25rem;
}
.section-h2 em { font-style: italic; color: var(–gold); }
.section-body {
font-family: var(–serif);
font-size: clamp(1rem, 2vw, 1.15rem);
font-weight: 300;
color: rgba(240,235,225,0.6);
line-height: 1.8;
max-width: 640px;
}

/* ── DIAMOND DIVIDER ─────────────────────────────── */
.diamond-divider {
text-align: center;
padding: 1rem 0;
color: var(–gold);
font-size: 0.7rem;
opacity: 0.6;
}

/* ── COLOUR SYSTEM ───────────────────────────────── */
.palette-grid {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
gap: 1px;
border: 1px solid var(–border);
margin-top: 3rem;
overflow: hidden;
}
.swatch {
aspect-ratio: 1;
position: relative;
cursor: default;
transition: transform 0.3s ease;
}
.swatch:hover { transform: scale(1.03); z-index: 2; }
.swatch-info {
position: absolute; bottom: 0; left: 0; right: 0;
padding: 0.75rem;
background: rgba(0,0,0,0.5);
backdrop-filter: blur(8px);
}
.swatch-name {
font-family: var(–label);
font-size: 0.6rem;
font-weight: 400;
letter-spacing: 0.12em;
text-transform: uppercase;
color: rgba(240,235,225,0.9);
}
.swatch-hex {
font-family: var(–mono);
font-size: 0.65rem;
color: rgba(240,235,225,0.45);
margin-top: 0.2rem;
}
.swatch-role {
font-family: var(–serif);
font-size: 0.7rem;
font-style: italic;
color: rgba(240,235,225,0.35);
margin-top: 0.15rem;
}

/* Extended palette chips */
.chips-row {
display: flex; gap: 1px;
margin-top: 1px;
}
.chip {
flex: 1; height: 48px;
position: relative;
transition: transform 0.2s;
}
.chip:hover { transform: scaleY(1.15); transform-origin: bottom; }
.chip-label {
position: absolute; bottom: 4px; left: 6px;
font-family: var(–mono); font-size: 0.5rem;
color: rgba(255,255,255,0.4); white-space: nowrap;
}

/* ── TYPOGRAPHY ───────────────────────────────────── */
.type-specimen { margin-top: 3rem; }
.type-row {
padding: 2.5rem 0;
border-bottom: 1px solid var(–border);
display: grid;
grid-template-columns: 200px 1fr;
gap: 2rem;
align-items: start;
}
.type-row:last-child { border-bottom: none; }
.type-meta {
padding-top: 0.5rem;
}
.type-meta-name {
font-family: var(–label);
font-size: 0.6rem;
letter-spacing: 0.2em;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 0.4rem;
}
.type-meta-detail {
font-family: var(–mono);
font-size: 0.6rem;
color: var(–cream-faint);
line-height: 1.8;
}
.type-display-hero {
font-family: var(–serif);
font-size: 5rem;
font-weight: 300;
line-height: 0.9;
letter-spacing: -0.02em;
}
.type-display-hero em { font-style: italic; color: var(–gold); }
.type-display-h2 {
font-family: var(–serif);
font-size: 2.8rem;
font-weight: 300;
line-height: 1.1;
}
.type-display-h2 em { font-style: italic; color: var(–gold); }
.type-body-large {
font-family: var(–serif);
font-size: 1.2rem;
font-weight: 300;
line-height: 1.75;
color: rgba(240,235,225,0.65);
}
.type-label-demo {
font-family: var(–label);
font-size: 0.62rem;
font-weight: 400;
letter-spacing: 0.3em;
text-transform: uppercase;
color: var(–gold);
display: flex; align-items: center; gap: 0.6rem;
}
.type-label-demo span { color: var(–cream-faint); }
.type-mono-demo {
font-family: var(–mono);
font-size: 0.75rem;
color: var(–cream-faint);
letter-spacing: 0.05em;
}

/* ── LOGO GRID ─────────────────────────────────────── */
.logo-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 1px;
border: 1px solid var(–border);
margin-top: 3rem;
overflow: hidden;
}
.logo-cell {
padding: 3rem 2rem;
display: flex; flex-direction: column;
align-items: center; justify-content: center;
gap: 1.5rem;
transition: background 0.3s;
}
.logo-cell:hover { background: rgba(255,255,255,0.02); }
.logo-cell img { max-height: 120px; width: auto; display: block; }
.logo-cell-meta {
text-align: center;
}
.logo-cell-name {
font-family: var(–label);
font-size: 0.58rem;
letter-spacing: 0.2em;
text-transform: uppercase;
color: var(–gold);
}
.logo-cell-use {
font-family: var(–serif);
font-size: 0.78rem;
font-style: italic;
color: var(–cream-faint);
margin-top: 0.2rem;
}

/* Nav logo variant */
.logo-nav-demo {
display: flex; align-items: center; gap: 0.75rem;
}
.logo-nav-sq {
width: 44px; height: 44px;
background: #fff;
display: flex; align-items: center; justify-content: center;
padding: 5px; flex-shrink: 0;
}
.logo-nav-sq img { width: 100%; height: 100%; object-fit: contain; }
.logo-nav-text {
font-family: var(–label);
font-size: 0.58rem;
letter-spacing: 0.22em;
text-transform: uppercase;
color: var(–cream-dim);
}

/* Logo on gold bg */
.bg-gold { background: var(–gold-btn); }
.bg-cream { background: var(–cream); }
.bg-white { background: #fff; }
.bg-black { background: var(–black); }
.bg-black-2 { background: var(–black-2); }

/* Clearspace diagram */
.clearspace-wrap {
display: inline-flex;
align-items: center; justify-content: center;
position: relative;
margin: 1rem;
}
.clearspace-wrap::before {
content: ‘’;
position: absolute;
inset: -24px;
border: 1px dashed rgba(196,154,42,0.3);
}
.clearspace-wrap::after {
content: ‘CLEAR ZONE’;
position: absolute;
bottom: -40px; left: 50%;
transform: translateX(-50%);
font-family: var(–label);
font-size: 0.5rem;
letter-spacing: 0.2em;
color: var(–gold-muted);
white-space: nowrap;
}

/* ── COMPONENTS ────────────────────────────────────── */
.component-group { margin-bottom: 4rem; }
.component-title {
font-family: var(–label);
font-size: 0.6rem;
letter-spacing: 0.25em;
text-transform: uppercase;
color: var(–gold);
padding-bottom: 1rem;
border-bottom: 1px solid var(–border-gold);
margin-bottom: 2rem;
}

/* Buttons — exact match to site */
.btn {
display: inline-flex; align-items: center; justify-content: center;
gap: 0.5rem;
font-family: var(–label);
font-size: 0.65rem;
font-weight: 400;
letter-spacing: 0.2em;
text-transform: uppercase;
cursor: pointer; border: none;
transition: all 0.3s ease;
text-decoration: none;
}
.btn-gold {
background: var(–gold-btn);
color: var(–black);
padding: 1rem 2.5rem;
}
.btn-gold:hover { background: var(–gold); }

.btn-outline {
background: transparent;
color: var(–gold);
padding: 0.85rem 2rem;
border: 1px solid var(–border-gold);
}
.btn-outline:hover { border-color: var(–gold); background: rgba(196,154,42,0.05); }

.btn-ghost {
background: transparent;
color: var(–cream-dim);
padding: 0.85rem 2rem;
border: 1px solid var(–border);
}
.btn-ghost:hover { border-color: rgba(255,255,255,0.2); color: var(–cream); }

.btn-tab {
background: transparent;
color: var(–cream-faint);
padding: 0.7rem 1.5rem;
border: 1px solid var(–border);
font-size: 0.58rem;
}
.btn-tab.active {
color: var(–gold);
border-color: var(–border-gold);
}

/* Cards — exact border/bg from site */
.card {
border: 1px solid var(–border);
padding: 1.5rem;
transition: border-color 0.3s, transform 0.3s;
background: transparent;
}
.card:hover { border-color: rgba(196,154,42,0.15); transform: translateY(-2px); }
.card-eyebrow {
font-family: var(–label);
font-size: 0.58rem;
letter-spacing: 0.2em;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 0.75rem;
}
.card-title {
font-family: var(–serif);
font-size: 1.1rem;
font-weight: 400;
margin-bottom: 0.5rem;
}
.card-body {
font-family: var(–serif);
font-size: 0.85rem;
font-weight: 300;
color: var(–cream-dim);
line-height: 1.7;
}

/* Section label format from site: “01 — ABOUT” */
.site-label {
font-family: var(–label);
font-size: 0.6rem;
letter-spacing: 0.28em;
text-transform: uppercase;
color: var(–gold);
display: flex; align-items: center; gap: 0.5rem;
}
.site-label .num { color: var(–cream-faint); }

/* Em dash used as bullet */
.em-dash-list { list-style: none; display: flex; flex-direction: column; gap: 1rem; }
.em-dash-list li {
display: flex; align-items: flex-start; gap: 1rem;
font-family: var(–serif); font-size: 0.95rem; font-weight: 300;
color: rgba(240,235,225,0.65); line-height: 1.6;
}
.em-dash-list li::before {
content: ‘—’;
color: var(–gold); flex-shrink: 0;
margin-top: 0.05em;
font-style: normal;
}

/* Input */
.input-wrap { display: flex; flex-direction: column; gap: 0.4rem; max-width: 360px; }
.input-label {
font-family: var(–label);
font-size: 0.58rem; letter-spacing: 0.15em;
text-transform: uppercase; color: var(–gold-muted);
}
.input-field {
background: transparent;
border: 1px solid var(–border);
padding: 0.75rem 1rem;
font-family: var(–serif); font-size: 0.9rem;
color: var(–cream); outline: none;
transition: border-color 0.3s;
}
.input-field:focus { border-color: var(–gold-muted); }
.input-field::placeholder { color: var(–cream-faint); }

/* Badge/tag */
.badge {
display: inline-flex;
padding: 0.2rem 0.7rem;
font-family: var(–label);
font-size: 0.55rem;
letter-spacing: 0.12em;
text-transform: uppercase;
}
.badge-gold { background: rgba(196,154,42,0.1); color: var(–gold); border: 1px solid rgba(196,154,42,0.2); }
.badge-dim  { background: transparent; color: var(–cream-dim); border: 1px solid var(–border); }
.badge-live { background: rgba(34,197,94,0.06); color: #4ade80; border: 1px solid rgba(74,222,128,0.15); }

/* Separator line with diamond */
.gold-rule {
display: flex; align-items: center; gap: 1rem;
margin: 2rem 0;
}
.gold-rule::before, .gold-rule::after {
content: ‘’; flex: 1;
height: 1px; background: var(–border-gold);
}
.gold-rule-diamond { color: var(–gold); font-size: 0.5rem; }

/* Platform tab demo (matches site exactly) */
.platform-tabs {
display: grid; grid-template-columns: 1fr 1fr;
border: 1px solid var(–border);
margin-bottom: 1px;
}
.platform-tab {
padding: 1rem 1.5rem;
font-family: var(–label);
font-size: 0.6rem; letter-spacing: 0.2em;
text-transform: uppercase;
color: var(–cream-faint);
border: none; background: transparent; cursor: pointer;
transition: color 0.3s;
border-right: 1px solid var(–border);
}
.platform-tab:last-child { border-right: none; }
.platform-tab.active { color: var(–gold); }

/* Nav demo strip */
.nav-demo {
display: flex; align-items: center; justify-content: space-between;
padding: 1rem 1.5rem;
border: 1px solid var(–border);
margin-bottom: 1px;
}
.nav-demo-links {
display: flex; gap: 2rem;
}
.nav-demo-links a {
font-family: var(–label);
font-size: 0.58rem; letter-spacing: 0.18em;
text-transform: uppercase;
color: var(–cream-faint); text-decoration: none;
transition: color 0.3s;
}
.nav-demo-links a:hover { color: var(–cream); }

/* Grid helpers */
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; }
.flex-row { display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-start; }

/* ── ICONOGRAPHY ───────────────────────────────────── */
.icon-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
gap: 1px;
border: 1px solid var(–border);
margin-top: 2rem; overflow: hidden;
}
.icon-cell {
display: flex; flex-direction: column;
align-items: center; justify-content: center;
gap: 0.5rem; padding: 1.5rem 0.5rem;
transition: background 0.2s;
}
.icon-cell:hover { background: rgba(196,154,42,0.04); }
.icon-cell svg { width: 20px; height: 20px; color: var(–gold); }
.icon-cell span {
font-family: var(–mono);
font-size: 0.48rem; color: var(–cream-faint);
letter-spacing: 0.05em;
}

/* ── MOTION / ANIMATION TOKENS ─────────────────────── */
.motion-row {
display: grid; grid-template-columns: 200px 1fr;
gap: 2rem; padding: 1.5rem 0;
border-bottom: 1px solid var(–border);
align-items: center;
}
.motion-row:last-child { border-bottom: none; }
.motion-label {
font-family: var(–label); font-size: 0.58rem;
letter-spacing: 0.15em; text-transform: uppercase;
color: var(–gold-muted);
}
.motion-demo {
height: 2px; background: var(–border);
position: relative; overflow: hidden;
}
.motion-demo-bar {
position: absolute; top: 0; left: -100%; height: 100%;
width: 60%; background: var(–gold);
animation: motionBar 2s var(–ease) infinite;
}
@keyframes motionBar {
0% { left: -60%; }
100% { left: 110%; }
}

/* ── SPACING SCALE ─────────────────────────────────── */
.spacing-row {
display: flex; align-items: flex-end;
gap: 1.5rem; padding: 2rem 0;
}
.spacing-block {
display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
}
.spacing-bar {
background: var(–gold);
width: 24px;
opacity: 0.7;
}
.spacing-label {
font-family: var(–mono);
font-size: 0.5rem; color: var(–cream-faint);
letter-spacing: 0.05em;
}

/* ── FOOTER ─────────────────────────────────────────── */
footer {
padding: 4rem 2.5rem 2rem;
border-top: 1px solid var(–border);
}
.footer-grid {
display: grid;
grid-template-columns: 1fr 1fr 1fr;
gap: 3rem; margin-bottom: 4rem;
}
.footer-col-label {
font-family: var(–label);
font-size: 0.58rem; letter-spacing: 0.22em;
text-transform: uppercase; color: var(–gold);
margin-bottom: 1.25rem;
}
.footer-col-item {
font-family: var(–serif);
font-size: 0.9rem; font-weight: 300;
color: var(–cream-dim); margin-bottom: 0.6rem;
display: block; text-decoration: none;
transition: color 0.2s;
}
.footer-col-item:hover { color: var(–cream); }
.footer-bottom {
padding-top: 2rem;
border-top: 1px solid var(–border);
display: flex; justify-content: space-between; align-items: center;
}
.footer-copy {
font-family: var(–label);
font-size: 0.55rem; letter-spacing: 0.1em;
color: var(–cream-faint);
}
.footer-locations {
font-family: var(–label);
font-size: 0.55rem; letter-spacing: 0.15em;
text-transform: uppercase; color: var(–cream-faint);
display: flex; gap: 1.25rem;
}

/* ── SCROLL REVEAL ─────────────────────────────────── */
.reveal {
opacity: 0; transform: translateY(28px);
transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1),
transform 0.7s cubic-bezier(0.16,1,0.3,1);
}
.reveal.visible { opacity: 1; transform: translateY(0); }

/* ── RESPONSIVE ────────────────────────────────────── */
@media (max-width: 768px) {
section { padding: 4rem 1.25rem; }
.logo-grid { grid-template-columns: 1fr; }
.type-row { grid-template-columns: 1fr; }
.motion-row { grid-template-columns: 1fr; }
.footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
.grid-2 { grid-template-columns: 1fr; }
.grid-3 { grid-template-columns: 1fr 1fr; }
.hero-h1 { font-size: 3rem; }
}
</style>

</head>
<body>

<!-- NAV -->

<nav id="nav">
  <div class="nav-logo">
    <img src="data:image/png;base64," alt="Zenitha Luxury">
  </div>
  <span class="nav-title">Brand Identity System</span>
</nav>

<!-- HERO -->

<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-noise"></div>
